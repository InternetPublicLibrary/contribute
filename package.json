{
  "name": "@ipl/contribute",
  "version": "0.1.0",
  "private": true,
  "description": "Internet Public Library contribution service: signed-in edits and suggestions as reviewed pull requests (hard fork of Staticman)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "types": "wrangler types --env-interface CloudflareBindings src/worker-configuration.d.ts",
    "bundle:check": "wrangler deploy --dry-run --outdir dist && node scripts/check-bundle.mjs dist",
    "check:links": "sh scripts/check-no-upstream-domain.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InternetPublicLibrary/contribute.git"
  },
  "homepage": "https://github.com/InternetPublicLibrary/contribute#readme",
  "dependencies": {
    "hono": "^4.13.14",
    "js-yaml": "^5.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.10",
    "@cloudflare/workers-types": "^5.20261011.1",
    "@eslint/js": "^9.39.5",
    "@types/js-yaml": "^4.0.9",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "fsevents": false
  }
}
