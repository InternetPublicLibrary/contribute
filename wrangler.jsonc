// contribute — Cloudflare Workers configuration (spec 001).
// Top level = local development and tests. Secrets are never committed: see README "Configuration".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ipl-contribute-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Each environment needs its own namespace: `wrangler kv namespace create CONTRIBUTE_KV --env <name>`.
  "kv_namespaces": [{ "binding": "CONTRIBUTE_KV", "id": "contribute-kv-dev" }],
  "vars": {
    "ENVIRONMENT": "development",
    "IPL_ALLOWED_ORIGINS": "http://localhost:4000",
    "CONTENT_REPOSITORIES": "{\"en-US\":\"InternetPublicLibrary/contribute-sandbox\",\"pt-BR\":\"InternetPublicLibrary/contribute-sandbox\",\"website\":\"InternetPublicLibrary/contribute-sandbox\"}",
    "ORCID_ENVIRONMENT": "sandbox"
  },
  "env": {
    "staging": {
      "name": "ipl-contribute-staging",
      // Same site as the IPL pages, so the SameSite=Lax session cookie is sent with their requests (spec 002).
      "workers_dev": false,
      "routes": [{ "pattern": "contribute.staging.ipl.better-web.org", "custom_domain": true }],
      "kv_namespaces": [{ "binding": "CONTRIBUTE_KV", "id": "REPLACE_WITH_STAGING_KV_ID" }],
      "vars": {
        "ENVIRONMENT": "staging",
        "IPL_ALLOWED_ORIGINS": "https://staging.ipl.better-web.org",
        "CONTENT_REPOSITORIES": "{\"en-US\":\"InternetPublicLibrary/contribute-sandbox\",\"pt-BR\":\"InternetPublicLibrary/contribute-sandbox\",\"website\":\"InternetPublicLibrary/contribute-sandbox\"}",
        "ORCID_ENVIRONMENT": "sandbox"
      }
    },
    "production": {
      "name": "ipl-contribute",
      "workers_dev": false,
      "routes": [{ "pattern": "contribute.ipl.better-web.org", "custom_domain": true }],
      "kv_namespaces": [{ "binding": "CONTRIBUTE_KV", "id": "REPLACE_WITH_PRODUCTION_KV_ID" }],
      "vars": {
        "ENVIRONMENT": "production",
        "IPL_ALLOWED_ORIGINS": "https://ipl.better-web.org",
        "CONTENT_REPOSITORIES": "{\"en-US\":\"InternetPublicLibrary/en-US\",\"pt-BR\":\"InternetPublicLibrary/pt-BR\",\"website\":\"InternetPublicLibrary/IPLibrary-website\"}",
        "ORCID_ENVIRONMENT": "production"
      }
    }
  }
}
